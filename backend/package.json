{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "lint": "echo \"No backend linter configured\"",
    "build": "npm run build:client",
    "build:client": "npm --prefix ../frontend run build",
    "dev:client": "npm --prefix ../frontend run dev",
    "serve:full": "npm run build:client && npm start",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "start:all": "npm run build:client && concurrently \"npm start\" \"npm run dev:client\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11"
  }
}
